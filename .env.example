# Copy this file to .env and fill in real values. Never commit .env.
POSTGRES_DB=retrodoc
POSTGRES_USER=retrodoc
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
REDIS_URL=redis://redis:6379/0

# Images (use specific version tags, not "latest")
BACKEND_IMAGE=ghcr.io/your-user/retrodoc-backend
BACKEND_TAG=0.1.0
FRONTEND_IMAGE=ghcr.io/your-user/retrodoc-frontend
FRONTEND_TAG=0.1.0

# Ports used on your laptop (dev only)
DB_PORT=5433
REDIS_PORT=6379
